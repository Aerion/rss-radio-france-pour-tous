# Rendered from this .template by nginx's built-in entrypoint (envsubst on
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/), substituting only
# variables actually present in the container's environment - so nginx's
# own $-variables below (e.g. $host, $remote_addr) are left untouched, and
# only the BLOCKED_UA_REGEX placeholder is replaced. See docker-compose.yml.

# BLOCKED_UA_REGEX is a case-insensitive regex alternation (e.g.
# "gptbot|bytespider"), kept out of the repo in .env - see .env.example.
# docker-compose defaults it to an impossible pattern ("a^": a "a" can
# never be followed by the start of the string) when unset, so a missing
# .env entry can't turn into "block everything" from an empty pattern.
map $http_user_agent $blocked_ua {
    default 0;
    "~*${BLOCKED_UA_REGEX}" 1;
}

# First path segment, for the nginx Grafana dashboard - e.g. /rss/{showId}
# -> "rss", /audio/{id} -> "audio", /grafana/... -> "grafana", / -> "home".
# Kept as a map (rather than `set` inside each location) so it stays
# independent of the blocked_ua `if` below; mixing `set`/`if` in the same
# location is a classic source of surprising nginx evaluation-order bugs.
map $uri $route {
    default "home";
    "~^/([^/]+)" "$1";
}

# JSON access log consumed by Loki/Grafana (see observability/grafana/dashboards/nginx.json).
log_format json_combined escape=json
    '{'
        '"time":"$time_iso8601",'
        '"remote_addr":"$remote_addr",'
        '"method":"$request_method",'
        '"uri":"$uri",'
        '"status":$status,'
        '"body_bytes_sent":$body_bytes_sent,'
        '"request_time":$request_time,'
        '"user_agent":"$http_user_agent",'
        '"blocked_ua":$blocked_ua,'
        '"route":"$route",'
        '"page":"$arg_page"'
    '}';

server {
    listen 8080;

    # This container is only reachable via 127.0.0.1:8080, and the only thing
    # that connects there is the host's cloudflared tunnel - so $remote_addr
    # is always the request's real source. Docker's port-publishing NATs that
    # loopback connection, though, so without this it shows up as the docker
    # bridge gateway (e.g. 172.18.0.1) for every request instead. Trust the
    # whole docker bridge range (172.16.0.0/12 covers any subnet compose may
    # assign) and read the real client IP from Cloudflare's own header.
    set_real_ip_from 172.16.0.0/12;
    real_ip_header CF-Connecting-IP;

    access_log /dev/stdout json_combined;

    location = /grafana {
        return 301 /grafana/;
    }

    location /grafana/ {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        if ($blocked_ua) {
            return 403;
        }
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
