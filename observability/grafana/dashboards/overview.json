{
  "uid": "radio-france-rss-overview",
  "title": "Radio France RSS - Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate by route (5xx)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency (p50 / p95) by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Upstream Radio France API latency (p50 / p95) by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(radiofrance_api_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(radiofrance_api_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Upstream Radio France API call outcome rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(radiofrance_api_requests_total[5m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recent logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"app\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Analytics pipeline events by outcome",
      "description": "written vs dropped (buffer full) vs failed (insert error) - dropped/failed rising means the Postgres usage dashboards are missing data.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(analytics_events_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Process health: goroutines",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_goroutines",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Process health: heap memory in use",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_memstats_heap_inuse_bytes",
          "legendFormat": "heap in use",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Manifestation cache lookups by outcome",
      "description": "hit vs miss for the Postgres-backed manifestation cache - a falling hit rate means more load pushed onto the Radio France API.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(manifestation_cache_lookups_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Manifestation cache hit ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(manifestation_cache_lookups_total{outcome=\"hit\"}[5m])) / sum(rate(manifestation_cache_lookups_total[5m]))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Feed cache lookups by outcome",
      "description": "hit vs miss for the in-memory rendered-feed cache - a falling hit rate means more full feed rebuilds per request.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(feed_cache_lookups_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Feed cache hit ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(feed_cache_lookups_total{outcome=\"hit\"}[5m])) / sum(rate(feed_cache_lookups_total[5m]))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Feed cache entries",
      "description": "current number of rendered feed pages held in the feed cache.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "feed_cache_entries",
          "legendFormat": "entries",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Enrichment queue depth",
      "description": "current number of episode-enrichment jobs waiting to be processed - sustained growth means the worker pool (ENRICHMENT_WORKERS) can't keep up with the miss rate.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "enrichment_queue_depth",
          "legendFormat": "depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "Enrichment jobs enqueued by outcome",
      "description": "queued vs duplicate (already pending) vs dropped (queue full, ENRICHMENT_QUEUE_SIZE too small for the miss rate).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(enrichment_queue_enqueued_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "title": "Enrichment jobs processed by kind and outcome",
      "description": "succeeded vs failed, split by manifestation vs origin enrichment - shows which background enrichment path is struggling, if any.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(enrichment_jobs_processed_total[5m])) by (kind, outcome)",
          "legendFormat": "{{kind}} ({{outcome}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "title": "Upstream Radio France calls: started vs completed",
      "description": "the gap between started and completed is calls currently in flight - a persistently growing gap means calls are hanging.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(radiofrance_api_requests_started_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}} started",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(radiofrance_api_requests_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}} completed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 19,
      "title": "Episodes cached (total)",
      "description": "Total rows in manifestation_cache, the Postgres-backed episode cache.",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 64 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT count(*) AS episodes FROM manifestation_cache",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Episodes cached by show",
      "description": "manifestation_cache rows per show, joined against shows for a friendly title (falls back to show_id if the show hasn't been resolved yet).",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 64 },
      "options": { "sortBy": [{ "displayName": "episodes", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT coalesce(s.title, m.show_id, 'unknown') AS show, count(*) AS episodes\nFROM manifestation_cache m\nLEFT JOIN shows s ON s.show_id = m.show_id\nGROUP BY 1\nORDER BY 2 DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "Postgres database size",
      "description": "Total on-disk size of the whole database (pg_database_size), across all tables and indexes.",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 72 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT pg_database_size(current_database()) AS bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Table sizes",
      "description": "On-disk size per table, including indexes and TOAST (pg_total_relation_size). Covers feed_cache, manifestation_cache, diffusion_origin_image_cache, and shows.",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 72 },
      "options": { "sortBy": [{ "displayName": "bytes", "desc": true }] },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT relname AS table, pg_total_relation_size(relid) AS bytes\nFROM pg_catalog.pg_statio_user_tables\nORDER BY 2 DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Active connections",
      "description": "Current Postgres connections to this database (pg_stat_activity).",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 4, "w": 9, "x": 15, "y": 72 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT count(*) AS connections FROM pg_stat_activity WHERE datname = current_database()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "Buffer cache hit ratio",
      "description": "Share of reads served from Postgres's shared buffer cache rather than disk (pg_stat_database). A sustained drop suggests the working set no longer fits in memory.",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 4, "w": 9, "x": 15, "y": 76 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT round(sum(blks_hit)::numeric / nullif(sum(blks_hit) + sum(blks_read), 0), 4) AS ratio\nFROM pg_stat_database\nWHERE datname = current_database()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "title": "Dead tuples per table (vacuum signal)",
      "description": "n_dead_tup per table (pg_stat_user_tables) - a bloat/vacuum-pressure signal. Rows grow here between autovacuum passes on tables with frequent ON CONFLICT upserts (feed_cache, manifestation_cache, diffusion_origin_image_cache).",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 80 },
      "options": { "sortBy": [{ "displayName": "dead_tuples", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT relname AS table, n_dead_tup AS dead_tuples FROM pg_stat_user_tables ORDER BY 2 DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 26,
      "title": "Stale manifestation_cache rows",
      "description": "manifestation_cache rows whose expires_at is already in the past - nothing currently prunes these, so this surfaces the unbounded-growth risk directly rather than leaving it invisible.",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 80 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "rawSql": "SELECT count(*) AS stale_rows FROM manifestation_cache WHERE expires_at < now()",
          "refId": "A"
        }
      ]
    }
  ]
}
