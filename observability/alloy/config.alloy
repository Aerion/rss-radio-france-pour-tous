// Discovers all containers on the host via the Docker socket, rather than
// the Loki Docker logging-driver plugin - that would need a host-level
// `docker plugin install` step outside this compose file, which is easy
// to forget when redeploying to a fresh box. This stays fully declared
// here, reproducible with just `docker compose up`.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = {"job" = "docker"}
  relabel_rules = discovery.relabel.containers.rules

  forward_to = [loki.process.reverseproxy.receiver]
}

// Promotes the nginx access log's "route" field (the first URL path
// segment - see proxy/templates/default.conf.template) to a real Loki
// label, so Grafana's dashboard variable editor can list its values: that
// editor only calls Loki's plain label-values API, which doesn't support a
// LogQL parser stage, so a value only reachable via `| json` at query time
// can't back a dashboard variable. Loki's structured metadata (the usual
// place for high-cardinality per-line fields) doesn't work here either -
// its values aren't exposed through that same API in this Loki version.
// Safe as a real label because route is low-cardinality: it's always one
// of a handful of known app routes, or (for scanner/bot noise) a path
// segment, never something per-request like a full URI or user agent -
// those stay query-time-only fields, extracted with `| json` as before.
// Non-reverseproxy log lines pass through this stage untouched.
loki.process "reverseproxy" {
  forward_to = [loki.write.default.receiver]

  stage.match {
    selector = "{service=\"reverseproxy\"}"

    stage.json {
      expressions = { route = "route" }
    }

    stage.labels {
      values = { route = "route" }
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
